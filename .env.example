# ==============================================================================
# PfunzoBridge Environment Configuration Template
# Copy this file to '.env' for local configuration. NEVER commit '.env' to git!
# ==============================================================================

# Django Secret Key (Generate a secure 50+ character random string for production)
DJANGO_SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production

# Debug Mode (Set to False in production)
DJANGO_DEBUG=True

# Allowed Hosts (Comma-separated list of hostnames/IPs)
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0

# Optional Database URL (defaults to SQLite if unset)
# DATABASE_URL=postgres://user:password@localhost:5432/pfunzobridge
